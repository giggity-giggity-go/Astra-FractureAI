# =============================================================================
# Astra-FractureAI · 环境变量模板(可提交到 git)
# =============================================================================
# ✅  本文件纯占位符,可安全提交到 Product Hunt 参赛仓库或 GitHub
# ✅  与 .env 字段结构完全一致
#
# 用法:
#   1. 复制本文件为 .env
#        cp .env.example .env         (macOS/Linux/Git Bash)
#        copy .env.example .env       (Windows cmd/PowerShell)
#   2. 编辑 .env,把 "REPLACE-ME" 替换为真实 key
#   3. 启动 app.py,python-dotenv 会自动加载 .env
#
# 字段说明:
#   YOLO_API_KEY              YOLO 云平台 Bearer token
#   YOLO_BASE_URL_POSITION    position 模型 endpoint(YOLO26 bipolar → FracAtlas)
#   YOLO_BASE_URL_RANGE       range 模型 endpoint(YOLO26 Roboflow v4)
#   YOLO_BASE_URL_KIND        kind 模型 endpoint(HBFMID,10 类骨折)
#   YOLO_TIMEOUT              YOLO 三模型 HTTP 超时(秒),默认 30
#   OPENAI_API_KEY            OpenAI 平台 API key(可兼容 MiniMax / DeepSeek 等 OpenAI 兼容端点)
#   OPENAI_BASE_URL           必须以 /v1 结尾;可换自建反代或第三方网关
#   OPENAI_MODEL              默认 gpt-4o-mini;兼容字段,二级回退
#   LLM_MODEL_PRIMARY         Primary 模型;为空时回退到 OPENAI_MODEL,再回退到 MiniMax-M3
#                             9-18 GPT-6 Astra 上线后,建议设 gpt-6-astra
#   LLM_FALLBACK              Primary 失败后的兜底模型,默认 deepseek-chat
#                             (临时策略可设与 Primary 相同,仅做重试,不切换厂商)
#   PORT                      Flask 监听端口,默认 8080
#   LOG_LEVEL                 日志级别 DEBUG/INFO/WARNING/ERROR,默认 INFO
# =============================================================================

# --- YOLO 云端三模型 ---
YOLO_API_KEY=sk-yolo-xxx
YOLO_BASE_URL_POSITION=https://your.ultralytics.cloud/v1/predict/position
YOLO_BASE_URL_RANGE=https://your.ultralytics.cloud/v1/predict/range
YOLO_BASE_URL_KIND=https://your.ultralytics.cloud/v1/predict/kind
YOLO_TIMEOUT=30

# --- OpenAI / 自定义 LLM ---
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- LLM 路由(优先级最高,空时回退到 OPENAI_MODEL) ---
LLM_MODEL_PRIMARY=
LLM_FALLBACK=deepseek-chat

# --- 服务器配置 ---
PORT=8080
LOG_LEVEL=INFO
